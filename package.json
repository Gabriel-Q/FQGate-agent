{
  "name": "fqgate-agent-workspace",
  "version": "1.0.0",
  "description": "FQGate 官方 Agent 插件：面向 Codex 与 Claude Code 提供本机行情、K 线、Level-2、资讯和研究工作流。",
  "keywords": [
    "fqgate",
    "tonghuasun-agent",
    "tonghuashun",
    "ai-plugin",
    "ai-agent",
    "mcp",
    "mcp-apps",
    "a-share",
    "china-stock",
    "stock-market",
    "market-data",
    "kline",
    "level-2",
    "codex",
    "claude-code"
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "build:mcp-apps": "npm --prefix mcp-apps run build:mcp-apps",
    "build:website-demo": "npm --prefix mcp-apps run build:website",
    "dev:publish": "npm --prefix mcp-apps run dev:publish",
    "embed:mcp-apps": "npm --prefix mcp-apps run typecheck && node scripts/embed-mcp-apps.mjs",
    "release:mcp-apps": "npm --prefix mcp-apps run release:mcp-apps --",
    "test:plugin": "node --test tests/plugin-integration.test.mjs tests/ai-tool-routing-evals.test.mjs scripts/release/versioning.test.mjs",
    "test": "npm run test:plugin && npm --prefix mcp-apps run test:mcp-apps"
  }
}
